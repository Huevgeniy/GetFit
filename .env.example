GEMINI_API_KEY=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
APP_URL=

# Postgres (Supabase). Если не задан — данные пишутся в data/cloud_db.json
# (годится только для локальной разработки: на Render файловая система эфемерная).
DATABASE_URL=

# Секрет для подписи сессионных токенов. Если пусто — выводится из TELEGRAM_BOT_TOKEN.
SESSION_SECRET=

# Секрет для проверки вебхука Telegram (заголовок X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=
