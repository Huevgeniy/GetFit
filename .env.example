GEMINI_API_KEY=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
APP_URL=

# Модели (необязательно). Groq — основной провайдер, Gemini — резервный.
# Внимание: из части сетей (в т.ч. российских и некоторых датацентров) Gemini API
# отвечает «User location is not supported» — тогда ИИ работает только через Groq.
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-flash-latest

# Postgres (Supabase). Если не задан — данные пишутся в data/cloud_db.json
# (годится только для локальной разработки: на Render файловая система эфемерная).
DATABASE_URL=

# Секрет для подписи сессионных токенов. Если пусто — выводится из TELEGRAM_BOT_TOKEN.
SESSION_SECRET=

# Секрет для проверки вебхука Telegram (заголовок X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=

# Секрет для запуска планировщика напоминаний: POST /api/notifications/run
CRON_SECRET=

# Часовой пояс пользователя в часах от UTC (по умолчанию 3 — Москва).
NOTIFY_TZ_OFFSET_HOURS=3

# STORAGE=file — принудительно локальный файл вместо Postgres.
# Удобно для проверок, чтобы не задеть боевую базу.
STORAGE=
